{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClientData Response Schema",
  "description": "Schema for the clientData API response containing client, programs, terminals, and analytics data",
  "type": "object",
  "properties": {
    "client": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "description": "Client ID"
        },
        "name": {
          "type": "string",
          "description": "Client name"
        },
        "activePrograms": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "Array of active program IDs for this client"
        }
      },
      "required": ["id", "name", "activePrograms"]
    },
    "programs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Program ID"
          },
          "name": {
            "type": "string",
            "description": "Program name"
          },
          "download_status_time": {
            "type": "string",
            "format": "date-time",
            "description": "When the program was downloaded"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "File name"
                },
                "total": {
                  "type": "integer",
                  "description": "Total file size in bytes"
                },
                "programId": {
                  "type": "integer",
                  "description": "Program ID this file belongs to"
                },
                "downloaded": {
                  "type": "integer",
                  "description": "Downloaded file size in bytes"
                }
              },
              "required": ["name", "total", "programId", "downloaded"]
            }
          },
          "thumbnail_url": {
            "type": ["string", "null"],
            "description": "URL to program thumbnail image"
          },
          "minutes_played_since_campaign_start": {
            "type": "integer",
            "description": "Total minutes played since campaign started"
          },
          "hours_played_since_campaign_start": {
            "type": "number",
            "description": "Total hours played since campaign started (decimal)"
          },
          "campaign_hours_bought": {
            "type": "number",
            "description": "Total hours purchased for this campaign"
          },
          "campaign_minutes_bought": {
            "type": "integer",
            "description": "Total minutes purchased for this campaign"
          },
          "campaign_completion_percent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "Campaign completion percentage"
          }
        },
        "required": [
          "id",
          "name",
          "download_status_time",
          "files",
          "thumbnail_url",
          "minutes_played_since_campaign_start",
          "hours_played_since_campaign_start",
          "campaign_hours_bought",
          "campaign_minutes_bought",
          "campaign_completion_percent"
        ]
      }
    },
    "terminals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "terminalId": {
            "type": "string",
            "description": "Terminal ID"
          },
          "name": {
            "type": ["string", "null"],
            "description": "Terminal name"
          },
          "group_name": {
            "type": ["string", "null"],
            "description": "Terminal group name"
          },
          "last_report_time": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "Last time terminal reported in"
          },
          "power_status": {
            "type": ["string", "null"],
            "description": "Power status of the terminal"
          },
          "isOnline": {
            "type": "boolean",
            "description": "Whether the terminal is currently online based on terminal_status_log"
          },
          "playing": {
            "type": ["object", "null"],
            "description": "Currently playing information, null if terminal is offline or not playing",
            "properties": {
              "program_id": {
                "type": "integer",
                "description": "Currently playing program ID"
              },
              "program_name": {
                "type": "string",
                "description": "Currently playing program name"
              },
              "file_name": {
                "type": "string",
                "description": "Currently playing file name"
              },
              "source": {
                "type": "string",
                "description": "Source of the content (e.g., 'internet')"
              },
              "started_at": {
                "type": "string",
                "format": "date-time",
                "description": "When playback started"
              }
            },
            "required": [
              "program_id",
              "program_name",
              "file_name",
              "source",
              "started_at"
            ]
          },
          "gps": {
            "type": ["object", "null"],
            "properties": {
              "longitude": {
                "type": "number",
                "description": "GPS longitude coordinate"
              },
              "latitude": {
                "type": "number",
                "description": "GPS latitude coordinate"
              },
              "last_updated": {
                "type": "string",
                "format": "date-time",
                "description": "When GPS data was last updated"
              }
            },
            "required": ["longitude", "latitude", "last_updated"]
          }
        },
        "required": [
          "terminalId",
          "name",
          "group_name",
          "last_report_time",
          "power_status",
          "playing",
          "gps"
        ]
      }
    },
    "historical_terminals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "terminal_id": {
            "type": "string",
            "description": "Terminal ID"
          },
          "programs_played": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "program_id": {
                  "type": "integer",
                  "description": "Program ID that was played"
                },
                "program_name": {
                  "type": "string",
                  "description": "Program name that was played"
                }
              },
              "required": ["program_id", "program_name"]
            }
          },
          "first_played_at": {
            "type": "string",
            "format": "date-time",
            "description": "When this terminal first played content"
          },
          "last_played_at": {
            "type": "string",
            "format": "date-time",
            "description": "When this terminal last played content"
          }
        },
        "required": [
          "terminal_id",
          "programs_played",
          "first_played_at",
          "last_played_at"
        ]
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "total_terminals": {
          "type": "integer",
          "description": "Total number of terminals"
        },
        "terminals_playing": {
          "type": "integer",
          "description": "Number of terminals currently playing"
        },
        "terminals_offline": {
          "type": "integer",
          "description": "Number of terminals that are offline"
        },
        "historical_terminals_count": {
          "type": "integer",
          "description": "Number of historical terminals"
        }
      },
      "required": [
        "total_terminals",
        "terminals_playing",
        "terminals_offline",
        "historical_terminals_count"
      ]
    },
    "heatmap": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "object",
          "properties": {
            "totalGpsPoints": {
              "type": "integer",
              "description": "Total number of GPS points in the heatmap"
            },
            "programsCount": {
              "type": "integer",
              "description": "Number of programs with GPS data"
            },
            "terminalsCount": {
              "type": "integer",
              "description": "Number of terminals with GPS data"
            },
            "dateRange": {
              "type": "string",
              "description": "Date range for the GPS data"
            }
          },
          "required": [
            "totalGpsPoints",
            "programsCount",
            "terminalsCount",
            "dateRange"
          ]
        },
        "programs": {
          "type": "object",
          "patternProperties": {
            "^[0-9]+$": {
              "type": "object",
              "properties": {
                "program_id": {
                  "type": "integer",
                  "description": "Program ID"
                },
                "program_name": {
                  "type": "string",
                  "description": "Program name"
                },
                "points": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "latitude": {
                        "type": "number",
                        "description": "GPS latitude coordinate"
                      },
                      "longitude": {
                        "type": "number",
                        "description": "GPS longitude coordinate"
                      },
                      "timestamp": {
                        "type": "string",
                        "format": "date-time",
                        "description": "When this GPS point was recorded"
                      },
                      "terminal_id": {
                        "type": "string",
                        "description": "Terminal ID that recorded this point"
                      },
                      "intensity": {
                        "type": "number",
                        "description": "Intensity value for heatmap visualization"
                      }
                    },
                    "required": [
                      "latitude",
                      "longitude",
                      "timestamp",
                      "terminal_id",
                      "intensity"
                    ]
                  }
                },
                "totalPoints": {
                  "type": "integer",
                  "description": "Total number of GPS points for this program"
                },
                "coverage": {
                  "type": "object",
                  "properties": {
                    "minLat": {
                      "type": "number",
                      "description": "Minimum latitude in the coverage area"
                    },
                    "maxLat": {
                      "type": "number",
                      "description": "Maximum latitude in the coverage area"
                    },
                    "minLng": {
                      "type": "number",
                      "description": "Minimum longitude in the coverage area"
                    },
                    "maxLng": {
                      "type": "number",
                      "description": "Maximum longitude in the coverage area"
                    },
                    "centerLat": {
                      "type": "number",
                      "description": "Center latitude of the coverage area"
                    },
                    "centerLng": {
                      "type": "number",
                      "description": "Center longitude of the coverage area"
                    }
                  },
                  "required": [
                    "minLat",
                    "maxLat",
                    "minLng",
                    "maxLng",
                    "centerLat",
                    "centerLng"
                  ]
                },
                "density": {
                  "type": "string",
                  "enum": ["low", "medium", "high"],
                  "description": "Density level of GPS points"
                },
                "avgPointsPerLocation": {
                  "type": "number",
                  "description": "Average points per unique location"
                }
              },
              "required": [
                "program_id",
                "program_name",
                "points",
                "totalPoints",
                "coverage",
                "density",
                "avgPointsPerLocation"
              ]
            }
          }
        }
      },
      "required": ["summary", "programs"]
    }
  },
  "required": [
    "client",
    "programs",
    "terminals",
    "historical_terminals",
    "summary",
    "heatmap"
  ]
}
