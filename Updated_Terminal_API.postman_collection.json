{
  "info": {
    "_postman_id": "updated-terminal-api-collection",
    "name": "Updated Terminal API Collection - Multi-Terminal Support",
    "description": "Collection for managing multiple terminals with batch operations including sleep/wake, brightness, GPS reporting, and reboot commands",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get All Terminals",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/terminals",
          "host": ["{{base_url}}"],
          "path": ["terminals"]
        },
        "description": "Retrieve all terminals using the configured terminal IDs"
      }
    },
    {
      "name": "Register Terminal",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sn\": \"TERMINAL_SERIAL_NUMBER\",\n  \"name\": \"My Terminal\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/terminals/register",
          "host": ["{{base_url}}"],
          "path": ["terminals", "register"]
        },
        "description": "Register a new terminal with serial number and name"
      }
    },
