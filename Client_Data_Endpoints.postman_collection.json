              "raw": "{{base_url}}/client/gps?gpsDays=7",
              "host": ["{{base_url}}"],
              "path": ["client", "gps"],
              "query": [
                {
                  "key": "gpsDays",
                  "value": "7",
                  "description": "Number of days to look back (default: 7)"
