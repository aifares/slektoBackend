# Run every minute to poll live GPS data
* * * * * cd /usr/src/app && node backend/jobs/fetch_gps_live.js

# Run daily at 2:00 AM to sync media metadata from ColorLight
0 2 * * * cd /usr/src/app && node backend/jobs/sync_media.js

# Run daily at 2:05 AM to create Share of Voice snapshots (after media sync)
5 2 * * * cd /usr/src/app && node backend/jobs/snapshot_share_of_voice.js

# Run every 5 minutes to check for completed campaigns and apply playlist transitions
*/5 * * * * cd /usr/src/app && node backend/jobs/apply_playlist_transitions.js
