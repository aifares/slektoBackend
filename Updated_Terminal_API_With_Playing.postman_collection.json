{
  "info": {
    "_postman_id": "updated-terminal-api-with-playing-collection",
    "name": "Updated Terminal API Collection - With Playing Analytics",
    "description": "Complete collection for managing terminals, content analytics, and GPS tracking. Includes terminal control operations, playing content analytics, and GPS data retrieval.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Terminal Operations",
      "item": [
        {
          "name": "Get All Terminals",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/terminals",
              "host": ["{{base_url}}"],
              "path": ["terminals"]
            },
            "description": "Retrieve all terminals using the configured terminal IDs"
          }
        },
