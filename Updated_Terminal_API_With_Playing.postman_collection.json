  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Set common variables",
          "pm.globals.set('timestamp', new Date().toISOString());",
          "pm.globals.set('today', new Date().toISOString().split('T')[0]);"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Common test for all requests",
          "pm.test('Status code is successful', function () {",
          "    pm.expect(pm.response.code).to.be.oneOf([200, 207, 404]);",
          "});",
          "",
          "pm.test('Response has expected structure', function () {",
          "    const jsonData = pm.response.json();",
          "    pm.expect(jsonData).to.be.an('object');",
          "});",
          "",
          "// Test for multi-terminal responses",
          "if (pm.response.code === 207) {",
          "    pm.test('Multi-status response has results and errors', function () {",
          "        const jsonData = pm.response.json();",
          "        pm.expect(jsonData).to.have.property('results');",
          "        pm.expect(jsonData).to.have.property('successful');",
          "        pm.expect(jsonData).to.have.property('failed');",
          "    });",
          "}",
          "",
          "// Test for power status responses",
          "if (pm.request.url.toString().includes('powerstatus')) {",
          "    pm.test('Power status response has terminals array', function () {",
          "        const jsonData = pm.response.json();",
          "        pm.expect(jsonData).to.have.property('terminals');",
          "        pm.expect(jsonData.terminals).to.be.an('array');",
          "    });",
          "}",
          "",
          "// Test for playing analytics responses",
          "if (pm.request.url.toString().includes('/playing/')) {",
          "    pm.test('Playing response has terminalId', function () {",
          "        const jsonData = pm.response.json();",
          "        pm.expect(jsonData).to.have.property('terminalId');",
          "    });",
          "}",
          "",
          "// Test for program analytics responses",
          "if (pm.request.url.toString().includes('analytics/programs')) {",
          "    pm.test('Program analytics response has programs array', function () {",
          "        const jsonData = pm.response.json();",
          "        pm.expect(jsonData).to.have.property('programs');",
          "        pm.expect(jsonData.programs).to.be.an('array');",
          "    });",
          "}",
          "",
          "// Test for GPS live responses",
          "if (pm.request.url.toString().includes('/gps/live')) {",
          "    pm.test('GPS live response has message', function () {",
          "        const jsonData = pm.response.json();",
          "        pm.expect(jsonData).to.have.property('message');",
          "    });",
          "",
          "    // Test for single terminal response (backward compatibility)",
          "    if (jsonData.hasOwnProperty('terminalId') && !jsonData.hasOwnProperty('terminals')) {",
          "        pm.test('Single terminal response has required fields', function () {",
          "            pm.expect(jsonData).to.have.property('terminalId');",
          "            pm.expect(jsonData).to.have.property('isOnline');",
          "            pm.expect(jsonData).to.have.property('status');",
          "            pm.expect(jsonData).to.have.property('gpsData');",
          "        });",
          "",
          "        pm.test('Single terminal isOnline is boolean', function () {",
          "            pm.expect(jsonData.isOnline).to.be.a('boolean');",
          "        });",
          "",
          "        pm.test('Single terminal status is valid', function () {",
          "            pm.expect(jsonData.status).to.be.oneOf(['online', 'offline', 'unknown']);",
          "        });",
          "    }",
          "",
          "    // Test for multi-terminal response",
          "    if (jsonData.hasOwnProperty('terminals')) {",
          "        pm.test('Multi-terminal response has required fields', function () {",
          "            pm.expect(jsonData).to.have.property('terminals');",
          "            pm.expect(jsonData).to.have.property('totalTerminals');",
          "            pm.expect(jsonData).to.have.property('onlineCount');",
          "            pm.expect(jsonData).to.have.property('offlineCount');",
          "            pm.expect(jsonData.terminals).to.be.an('array');",
          "        });",
          "",
          "        pm.test('Each terminal in array has required fields', function () {",
          "            jsonData.terminals.forEach(function(terminal) {",
          "                pm.expect(terminal).to.have.property('terminalId');",
          "                pm.expect(terminal).to.have.property('isOnline');",
          "                pm.expect(terminal).to.have.property('status');",
          "                pm.expect(terminal).to.have.property('gpsData');",
          "                pm.expect(terminal.isOnline).to.be.a('boolean');",
